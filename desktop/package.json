{
  "name": "@todo/desktop",
  "productName": "Spade",
  "version": "0.1.0",
  "description": "Spade, the planner, as a desktop app",
  "author": "Spade",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
