{
  "name": "voice-todo",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop:dev": "npm run dev -w desktop",
    "desktop:pack": "npm run pack -w desktop",
    "app:uninstall": "bash scripts/app.sh uninstall",
    "app:logs": "bash scripts/app.sh logs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.14"
  }
}
